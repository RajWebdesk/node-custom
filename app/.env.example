# Environment template. Names and placeholders only. Never commit real values.
# Real values come from the local environment or a secret reference, handed over outside the repo.

NODE_ENV=development
APP_TIMEZONE=America/Toronto

# Database (local Docker Compose)
DATABASE_URL=PLACEHOLDER_LOCAL_ONLY

# Sessions and CSRF
SESSION_SECRET=PLACEHOLDER_SECRET_REFERENCE
SESSION_TTL_MINUTES=PLACEHOLDER

# Password hashing (Argon2id, proposed)
PASSWORD_HASH_ALGORITHM=argon2id
ARGON2_MEMORY_KIB=PLACEHOLDER_VERIFY_AT_IMPLEMENTATION
ARGON2_ITERATIONS=PLACEHOLDER_VERIFY_AT_IMPLEMENTATION
ARGON2_PARALLELISM=PLACEHOLDER_VERIFY_AT_IMPLEMENTATION

# Email provider (team to decide; Brevo suggested, not confirmed)
EMAIL_PROVIDER=PLACEHOLDER
EMAIL_PROVIDER_API_KEY=PLACEHOLDER_SECRET_REFERENCE
EMAIL_SENDER_ADDRESS=PLACEHOLDER_VERIFIED_SENDER

# Scheduler (due reminders)
REMINDER_SLOT_LOCAL_TIME=09:00
REMINDER_RUN_LOCK_TTL_SECONDS=PLACEHOLDER

# Operations (team to decide later)
SHUTDOWN_DRAIN_SECONDS=PLACEHOLDER
